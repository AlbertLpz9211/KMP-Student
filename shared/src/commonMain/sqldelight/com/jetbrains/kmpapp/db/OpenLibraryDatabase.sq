CREATE TABLE ItemEntity (
    id TEXT NOT NULL PRIMARY KEY,
    titulo TEXT NOT NULL,
    subtitulo TEXT,
    imagenUrl TEXT,
    metrica REAL,
    fecha TEXT,
    isFavorite INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    status TEXT NOT NULL DEFAULT 'NONE',
    cachedAt INTEGER NOT NULL
);

CREATE TABLE TagEntity (
    itemId TEXT NOT NULL,
    tag TEXT NOT NULL,
    PRIMARY KEY (itemId, tag),
    FOREIGN KEY (itemId) REFERENCES ItemEntity(id) ON DELETE CASCADE
);

CREATE TABLE ItemDetalleEntity (
    itemId TEXT NOT NULL PRIMARY KEY,
    descripcion TEXT NOT NULL,
    FOREIGN KEY (itemId) REFERENCES ItemEntity(id) ON DELETE CASCADE
);

CREATE TABLE AtributoEntity (
    itemId TEXT NOT NULL,
    etiqueta TEXT NOT NULL,
    valor TEXT NOT NULL,
    PRIMARY KEY (itemId, etiqueta, valor),
    FOREIGN KEY (itemId) REFERENCES ItemDetalleEntity(itemId) ON DELETE CASCADE
);

-- Queries
insertItem:
INSERT OR REPLACE INTO ItemEntity(id, titulo, subtitulo, imagenUrl, metrica, fecha, isFavorite, status, cachedAt)
VALUES (:id, :titulo, :subtitulo, :imagenUrl, :metrica, :fecha,
    COALESCE((SELECT isFavorite FROM ItemEntity WHERE id = :id), 0),
    COALESCE((SELECT status FROM ItemEntity WHERE id = :id), 'NONE'),
    :cachedAt
);

insertTag:
INSERT OR REPLACE INTO TagEntity(itemId, tag) VALUES (?, ?);

deleteTags:
DELETE FROM TagEntity WHERE itemId = ?;

insertDetalle:
INSERT OR REPLACE INTO ItemDetalleEntity(itemId, descripcion) VALUES (?, ?);

insertAtributo:
INSERT OR REPLACE INTO AtributoEntity(itemId, etiqueta, valor) VALUES (?, ?, ?);

deleteAtributos:
DELETE FROM AtributoEntity WHERE itemId = ?;

selectAllItems:
SELECT * FROM ItemEntity ORDER BY cachedAt DESC;

selectTagsForItem:
SELECT tag FROM TagEntity WHERE itemId = ?;

selectDetailById:
SELECT * FROM ItemDetalleEntity WHERE itemId = ?;

selectAtributosForDetail:
SELECT etiqueta, valor FROM AtributoEntity WHERE itemId = ?;

updateFavorite:
UPDATE ItemEntity SET isFavorite = ? WHERE id = ?;

deleteNonFavoriteItemsOlderThan:
DELETE FROM ItemEntity WHERE isFavorite = 0 AND cachedAt < ?;

selectItemById:
SELECT * FROM ItemEntity WHERE id = ?;

selectFavoriteItems:
SELECT * FROM ItemEntity WHERE isFavorite = 1 ORDER BY cachedAt DESC;

updateStatus:
UPDATE ItemEntity SET status = ? WHERE id = ?;

selectMyBooks:
SELECT * FROM ItemEntity WHERE status != 'NONE' ORDER BY cachedAt DESC;
